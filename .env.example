# ============================================================================
# AVA Educacional - Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env e preencha com seus dados reais
# ============================================================================

# Supabase Configuration
# =====================
# 1. Acesse https://supabase.com e crie um projeto
# 2. Vá em Settings > API
# 3. Copie o Project URL e a anon key

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=sua_chave_anon_aqui
SUPABASE_SERVICE_KEY=sua_chave_service_aqui

# App Configuration
# =================
# Gere uma chave secreta com: python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=gerar_chave_secreta_aqui
DEBUG=true
